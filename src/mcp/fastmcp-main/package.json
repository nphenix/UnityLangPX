{
  "name": "@unitylangpx/fastmcp",
  "version": "1.0.0",
  "main": "dist/unitylang-server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/unitylang-server.js",
    "dev": "ts-node src/unitylang-server.ts",
    "start:dev": "ts-node src/start-server.ts"
  },
  "keywords": [
    "MCP",
    "SSE",
    "UnityLangPX"
  ],
  "type": "module",
  "author": "UnityLangPX Team",
  "license": "MIT",
  "description": "UnityLangPX MCP server implementation based on FastMCP framework.",
  "module": "dist/FastMCP.js",
  "types": "dist/FastMCP.d.ts",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@standard-schema/spec": "^1.0.0",
    "execa": "^9.6.0",
    "file-type": "^21.0.0",
    "fuse.js": "^7.1.0",
    "mcp-proxy": "^5.8.1",
    "strict-event-emitter-types": "^2.0.0",
    "undici": "^7.13.0",
    "uri-templates": "^0.2.0",
    "xsschema": "0.3.0",
    "yargs": "^18.0.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "repository": {
    "url": "https://github.com/your-org/UnityLangPX"
  },
  "homepage": "https://github.com/your-org/UnityLangPX",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@modelcontextprotocol/inspector": "^0.16.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.2.1",
    "@types/uri-templates": "^0.1.34",
    "@types/yargs": "^17.0.33",
    "@valibot/to-json-schema": "^1.3.0",
    "@wong2/mcp-cli": "^1.13.0",
    "arktype": "^2.1.20",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eventsource-client": "^1.1.4",
    "get-port-please": "^3.2.0",
    "jiti": "^2.5.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "valibot": "^1.1.0"
  },
  "tsup": {
    "entry": [
      "src/FastMCP.ts",
      "src/bin/fastmcp.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true,
    "splitting": true,
    "sourcemap": true,
    "clean": true
  }
}